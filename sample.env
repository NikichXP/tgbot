# ============================================================================
# tg-bot - Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in secrets for local development:
#   cp sample.env .env
# ============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/tg-bot
MONGODB_DATABASE=tg-bot

# Bot Admin & General
APP_ADMIN_ID=34080460
APP_ADMIN_BOT=
APP_WEBHOOK=https://bot.nikichxp.xyz/handle
APP_LOCAL_ENV=true
APP_SUSPEND_BOT_REGISTERING=true

# Bot Tokens
APP_TOKENS_NIKICHBOT=
APP_TOKENS_ALLMYSTUFFBOT=
APP_TOKENS_SANTABOT=
APP_TOKENS_DEMOBOT=
APP_TOKENS_CHILDTRACKERBOT=

# Warehouse Service
APP_WAREHOUSE_URL=https://warehouse.nikichxp.xyz/storage

# Tracer Configuration
APP_TRACER_STORE=true
APP_TRACER_TTL=24
APP_TRACER_CAPACITY=100
APP_TRACER_TOKEN=

# OpenRouter (AI / LLM)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://bot.nikichxp.xyz
OPENROUTER_TITLE=TGBot
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1

# Discord Integration
DISCORD_PUBLIC_KEY=

# Trusted Users (comma-separated list: "username", "12345", etc.)
APP_TRUSTED_USERS=