# ============================================================================
# tg-bot - Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in secrets for local development:
#   cp sample.env .env
# ============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/tg-bot
MONGODB_DATABASE=tg-bot

# RabbitMQ Connection
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# okx-collector (/prices)
OKX_COLLECTOR_URL=http://localhost:8080

# Bot Admin & General
APP_ADMIN_ID=34080460
APP_ADMIN_BOT=nikichbot
APP_WEBHOOK=https://bot.nikichxp.xyz/handle
APP_LOCAL_ENV=true
APP_SUSPEND_BOT_REGISTERING=true
APP_MAX_RETRY_COUNT=5


# Tracer Configuration
APP_TRACER_STORE=true
APP_TRACER_TTL=24
APP_TRACER_CAPACITY=100
APP_TRACER_TOKEN=

# OpenRouter (AI / LLM)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://github.com/NikichXP/tgbot
OPENROUTER_TITLE=NikichXP TG Bot
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1

# Discord Integration
DISCORD_PUBLIC_KEY=

# Trusted Users (comma-separated list: "username", "12345", etc.)
APP_TRUSTED_USERS=
# Redis (dashboard access tokens)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# Dashboard (web admin UI)
# Bot whose token verifies "Login with Telegram" (defaults to APP_ADMIN_BOT); its domain must be set via @BotFather /setdomain
APP_DASHBOARD_LOGIN_BOT=
APP_DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173
APP_DASHBOARD_ACCESS_TOKEN_TTL_MINUTES=15
# false only for local http dev in browsers that reject Secure cookies on http://localhost (Safari)
APP_DASHBOARD_SECURE_COOKIE=false
